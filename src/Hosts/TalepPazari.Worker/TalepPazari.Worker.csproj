<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Shared with the Api host so one `dotnet user-secrets set` configures both. -->
    <UserSecretsId>taleppazari-local-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Traces and metrics (ADR-007); exporter chosen by Telemetry:Exporter (docs/architecture/observability.md). -->
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Composition only: hosts reference module Infrastructure projects (ADR-002). -->
    <ProjectReference Include="..\..\Modules\Example\TalepPazari.Modules.Example.Infrastructure\TalepPazari.Modules.Example.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The outbox dispatcher depends only on the SharedKernel messaging abstractions. -->
    <ProjectReference Include="..\..\Shared\TalepPazari.SharedKernel\TalepPazari.SharedKernel.csproj" />
  </ItemGroup>

</Project>
