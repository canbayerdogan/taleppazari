# Local development settings for compose.yaml.
# Copy to .env (never commit .env):
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
#
# These values are obviously fake placeholders for a local, loopback-only database.
# You may change them in your own .env (no spaces or quotes in values).
# Never reuse this password anywhere real.
# Changing credentials after the first start has no effect until you reset the
# database (docker compose down -v), which wipes all local data.

POSTGRES_USER=taleppazari_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=taleppazari_local

# Host port, bound to 127.0.0.1 only. Change it if 5432 is already in use.
POSTGRES_PORT=5432
