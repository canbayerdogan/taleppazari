# Minimal baseline. Add rules only when the team agrees on them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning

# Nullable reference types are enabled in Directory.Build.props (T-003), not here.

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

# EF Core migrations are tool-generated; the main migration file lacks an <auto-generated> header.
[src/Modules/**/Persistence/Migrations/*.cs]
generated_code = true
