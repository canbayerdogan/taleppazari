# Normalize text files to LF in the repository and the working tree.
* text=auto eol=lf

# Windows scripts need CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: no line-ending conversion, no textual diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.dll binary
*.exe binary
