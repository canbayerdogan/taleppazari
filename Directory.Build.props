<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>

    <!--
      Warnings are errors so the build stays at zero warnings. This includes NuGet audit
      advisories (NU1901-NU1904): a vulnerable dependency fails restore. If an advisory
      cannot be fixed right away, suppress that single advisory explicitly with a
      <NuGetAuditSuppress Include="advisory URL" /> item plus a reason and follow-up issue;
      never exclude the NU190x codes globally.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- .NET analyzers and .editorconfig code style rules run during build.
         AnalysisLevel is pinned to the target framework so the rule set does not change with the SDK. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible output. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
